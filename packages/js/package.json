{
  "name": "rolodexter",
  "version": "2.13.0",
  "description": "Universal contact field mapper for JavaScript and TypeScript.",
  "type": "module",
  "license": "MIT",
  "author": "RoloDexter Contributors",
  "keywords": [
    "contact",
    "mapper",
    "normalizer",
    "etl",
    "crm",
    "field-mapping",
    "data-cleaning"
  ],
  "homepage": "https://github.com/LunarWerxs/RoloDexter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunarWerxs/RoloDexter.git",
    "directory": "packages/js"
  },
  "bugs": {
    "url": "https://github.com/LunarWerxs/RoloDexter/issues"
  },
  "bin": {
    "rolodexter": "dist/src/cli.js",
    "rolodexter-i18n": "dist/src/i18n.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/public.d.ts",
      "import": "./dist/src/public.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./core": {
      "types": "./dist/src/core.d.ts",
      "import": "./dist/src/core.js",
      "require": "./dist/cjs/core.cjs"
    },
    "./i18n": {
      "types": "./dist/src/i18n.d.ts",
      "import": "./dist/src/i18n.js",
      "require": "./dist/cjs/i18n.cjs"
    }
  },
  "types": "./dist/src/public.d.ts",
  "files": [
    "README.md",
    "dist/src",
    "dist/cjs",
    "!dist/src/**/*.test.*",
    "!dist/cjs/**/*.test.*",
    "!dist/src/i18n/*.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync:patterns": "node scripts/sync-patterns.mjs",
    "check:patterns": "node scripts/sync-patterns.mjs --check",
    "build": "npm run sync:patterns && tsc -p tsconfig.json && node scripts/build-cjs.mjs && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "coverage": "npm run build && node scripts/run-tests.mjs --coverage",
    "check:parity": "python ../../scripts/check_release_versions.py && python ../../scripts/parity_probe.py && python ../../scripts/cli_parity_probe.py && python ../../scripts/api_snapshot.py",
    "check:sweep": "python ../../scripts/parity_sweep.py --no-languages",
    "prepack": "npm run build"
  },
  "dependencies": {
    "csv-stringify": "^6.9.0",
    "fuzzball": "^2.2.6",
    "libphonenumber-js": "^1.13.15"
  },
  "peerDependencies": {
    "@vitalets/google-translate-api": "^9.2.1",
    "unidecode": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "@vitalets/google-translate-api": {
      "optional": true
    },
    "unidecode": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitalets/google-translate-api": "^9.2.1",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "unidecode": "^1.1.0"
  }
}
